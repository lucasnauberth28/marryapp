generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum PaymentStatus {
  PENDING
  APPROVED
  FAILED
  REFUNDED
  REJECTED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
}

enum ExpenseStatus {
  PENDING
  PAID
  OVERDUE
}

enum ExpenseType {
  CONTRACT
  PURCHASE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// ==========================================
// MODELS
// ==========================================

model Guest {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id                 String        @id @default(uuid())
  name               String
  phone              String?       
  email              String?
  category           String?       // Padrinho/Madrinha, Participantes de cerimônia, Pais, Família, Amigo/Colega
  rsvpStatus         RsvpStatus    @default(PENDING)
  allowedCompanions  Int           @default(0)
  confirmedCompanions Int          @default(0)
  companionsNames    String?       @db.Text
  hasReceivedMessage Boolean       @default(false) 
  
  // Vínculo entre convidados (Titular / Familiar vinculado)
  parentGuestId      String?
  parentGuest        Guest?        @relation("GuestLink", fields: [parentGuestId], references: [id], onDelete: SetNull)
  linkedGuests       Guest[]       @relation("GuestLink")

  // Credenciamento e Restrições
  isPresent          Boolean       @default(false)
  checkInTime        DateTime?
  dietaryRestrictions String?      @db.Text

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tableId            String?
  table              Table?        @relation(fields: [tableId], references: [id])

  transactions       Transaction[] 

  @@index([weddingId])
  @@map("guests")
}

model TimelineEvent {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id          String   @id @default(uuid())
  title       String
  time        String   // Ex: "18:00"
  description String?  @db.Text
  icon        String   @default("Clock") // Nome do ícone no Lucide
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([weddingId])
  @@map("timeline_events")
}

model Table {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id          String   @id @default(uuid())
  name        String
  capacity    Int      @default(10)
  createdAt   DateTime @default(now())

  guests      Guest[]

  @@index([weddingId])
  @@map("tables")
}

model Gift {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id          String        @id @default(uuid())
  title       String
  description String?
  amount      Int           
  imageUrl    String?
  isPurchased Boolean       @default(false)
  createdAt   DateTime      @default(now())

  transactions Transaction[]

  @@index([weddingId])
  @@map("gifts")
}

model Transaction {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id                String        @id @default(uuid())
  gatewayId         String?       
  guestName         String?
  amount            Int           
  netAmount         Int?          
  fee               Int?          @default(0)
  paymentMethod     PaymentMethod 
  status            PaymentStatus @default(PENDING)
  externalReference String?       
  thankYouSent      Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt

  giftId            String
  gift              Gift          @relation(fields: [giftId], references: [id])
  guestId           String?       
  guest             Guest?        @relation(fields: [guestId], references: [id])

  @@index([weddingId])
  @@map("transactions")
}

model Vendor {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id          String    @id @default(uuid())
  name        String
  category    String    
  contact     String?
  contractUrl String?   
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())

  expenses    Expense[]

  @@index([weddingId])
  @@map("vendors")
}

model Expense {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id            String        @id @default(uuid())
  description   String
  amount        Int           
  dueDate       DateTime
  status        ExpenseStatus @default(PENDING)
  type          ExpenseType   @default(CONTRACT)
  purchaseUrl   String?       
  paymentMethod String?       
  imageUrl      String?       @db.Text
  storeName     String?       
  createdAt     DateTime      @default(now())

  vendorId      String?       
  vendor        Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([weddingId])
  @@map("expenses")
}

model Task {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id          String     @id @default(uuid())
  title       String
  description String?    @db.Text
  dueDate     DateTime?
  assignee    String?    
  status      TaskStatus @default(TODO)
  position    Int        
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([weddingId])
  @@map("tasks")
}

model HoneymoonItem {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id          String   @id @default(uuid())
  title       String
  category    String   
  amount      Int      
  isPaid      Boolean  @default(false)
  plannedDate DateTime?
  createdAt   DateTime @default(now())

  @@index([weddingId])
  @@map("honeymoon_items")
}

model MessageTemplate {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id        String   @id @default(uuid())
  name      String
  type      String?  // "INITIAL_INVITE", "RSVP_REMINDER", "CUSTOM"
  content   String   @db.Text
  mediaUrl  String?
  mediaType String?  // Ex: image, document, audio
  buttons   String?  @db.Text // JSON string: [{ id: "confirm", text: "✅ Confirmar Presença" }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weddingId])
  @@map("message_templates")
}

model SystemSettings {
  id                 String    @id @default(uuid())
  weddingId          String    @unique
  wedding            Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  rsvpDeadline       DateTime?
  weddingDate        DateTime?
  weddingLocation    String?   @db.Text
  weddingLocationUrl String?   @db.Text
  themeColor         String    @default("#18181b")
  heroImageUrl       String?
  welcomeText        String?   @db.Text
  updatedAt          DateTime  @updatedAt

  @@map("system_settings")
}

model Role {
  id           String   @id @default(uuid())
  name         String   @unique
  allowedPaths Json     // JSON string array de paths permitidos
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]

  @@map("roles")
}

model User {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  password  String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Conta de fornecedor: vincula o login ao perfil do marketplace (painel /fornecedor)
  partnerVendorId String?        @unique
  partnerVendor   PartnerVendor? @relation(fields: [partnerVendorId], references: [id], onDelete: SetNull)

  // Casamento do qual a conta faz parte (o casal e o par convidado)
  weddingId       String?
  wedding         Wedding?       @relation(fields: [weddingId], references: [id], onDelete: SetNull)

  subscriptions   Subscription[]
  passwordResets  PasswordResetToken[]
  notifications   Notification[]

  @@map("users")
}

// Central de avisos: um registro por pessoa (avisos do casal viram um por usuário do casamento).
// `type` é uma chave do catálogo (lib/notifications/catalog); `dedupeKey` evita avisos repetidos
// (ex.: "gift_paid:<transação>"), mesmo que o webhook ou a rotina rodem duas vezes.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String    @db.Text
  href      String?
  weddingId String?
  vendorId  String?
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// Cobrança de um plano pago (Pix). O plano só é aplicado quando o pagamento é aprovado,
// pelo webhook do Mercado Pago ou pela conferência na tela do Pix (o que chegar primeiro).
model Subscription {
  id          String        @id @default(uuid())
  // Conta que pagou. Fica nulo se a conta for excluída: o pagamento é guardado para fins fiscais.
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  planId      String        // chave do catálogo (lib/plans): classic, vip, pro, master ou custom
  planType    String        // "COUPLE" | "VENDOR"
  planName    String
  modules     Json?         // módulos do plano adaptado
  weddingId   String?       // planos de casal valem para o casamento (os dois do casal)
  wedding     Wedding?      @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  couponCode  String?
  discount    Int?          // centavos abatidos por cupom
  credit      Int?          // centavos abatidos pelo período não usado (troca de plano)
  amount      Int           // centavos, sempre do catálogo
  status      PaymentStatus @default(PENDING)
  gatewayId   String?       @unique // id do pagamento no Mercado Pago (ou txid do Pix estático)
  expiresAt   DateTime      // validade do código Pix
  paidAt      DateTime?
  periodEnd   DateTime?     // fim do período pago (planos mensais de fornecedor)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, status])
  @@index([weddingId, status])
  @@map("subscriptions")
}

model WalletBalance {
  id        String   @id @default(uuid())
  weddingId String   @unique
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  balance   Int      @default(0) // Valor em centavos
  updatedAt DateTime @updatedAt

  @@map("wallet_balance")
}

model CreditCard {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id         String   @id @default(uuid())
  bank       String   
  brand      String   
  nickname   String?  
  lastDigits String?  
  limit      Int      @default(0) // Limite atual em centavos
  color      String?  @default("#18181b") 
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([weddingId])
  @@map("credit_cards")
}

// ==========================================
// CONSTRUTOR DE SITE NO-CODE & STORYTELLING
// ==========================================

model SiteCustomization {
  id                 String   @id @default(uuid())
  weddingId          String   @unique
  wedding            Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  slug               String   @default("lucas-e-giovanna")
  customDomain       String?  
  title              String   @default("Lucas & Giovanna")
  subtitle           String   @default("Vamos nos casar!")
  weddingDate        DateTime?
  ceremonyTime       String?  @default("16:30")
  receptionTime      String?  @default("18:30")
  locationName       String?  @default("Espaço Monte Castelo")
  locationAddress    String?  @default("Rua das Flores, 1200 - São Paulo, SP")
  locationMapUrl     String?  @db.Text
  wazeUrl            String?  @db.Text
  uberUrl            String?  @db.Text
  themeColor         String   @default("#8C6D45")
  fontFamily         String   @default("serif") // "serif", "sans", "playfair", "cormorant"
  heroImageUrl       String?  @db.Text
  couplePhotoUrl     String?  @db.Text
  dressCodeTitle     String?  @default("Passeio Completo")
  dressCodeDesc      String?  @db.Text
  dressCodePalette   String?  // JSON array de cores hexadecimais
  spotifyPlaylistUrl String?  @db.Text
  welcomeMessage     String?  @db.Text

  // Liga / Desliga de Blocos Modulares
  showStory          Boolean  @default(true)
  showLocation       Boolean  @default(true)
  showDressCode      Boolean  @default(true)
  showTips           Boolean  @default(true)
  showGifts          Boolean  @default(true)
  showRsvp           Boolean  @default(true)
  showGuestbook      Boolean  @default(true)
  showMusic          Boolean  @default(true)

  updatedAt          DateTime @updatedAt

  @@map("site_customization")
}

model WeddingStoryItem {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id          String   @id @default(uuid())
  title       String   // Ex: "O Primeiro Encontro", "O Pedido de Casamento"
  dateLabel   String?  // Ex: "Outubro de 2021"
  description String   @db.Text
  imageUrl    String?  @db.Text
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([weddingId])
  @@map("wedding_story_items")
}

model WeddingTip {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id          String   @id @default(uuid())
  category    String   // "HOTEL", "SALON", "TRANSFER", "DRESS"
  title       String   // Ex: "Hotel Blue Tree", "Salão Studio Beauty"
  description String?  @db.Text
  address     String?  
  phone       String?  
  linkUrl     String?  @db.Text
  discountCode String? // Ex: "CASAMENTOLUCAS10"
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([weddingId])
  @@map("wedding_tips")
}

model GuestBookEntry {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id          String   @id @default(uuid())
  authorName  String
  message     String   @db.Text
  imageUrl    String?  @db.Text
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([weddingId])
  @@map("guest_book_entries")
}

// ==========================================
// MARKETPLACE DE FORNECEDORES POR REGIÃO
// ==========================================

enum VendorPlanTier {
  FREE
  PRO
  MASTER
}

model PartnerVendor {
  id               String         @id @default(uuid())
  companyName      String
  category         String         // "Espaço", "Buffet", "Fotografia", "Decoração", "DJ & Som", "Vestidos", "Doces & Bolo"
  description      String?        @db.Text
  logoUrl          String?        @db.Text
  coverUrl         String?        @db.Text
  galleryImages    String?        @db.Text // JSON string array de URLs
  startingPrice    Int?           // Valor inicial em centavos (ex: 250000 = R$ 2.500)
  averageTicket    Int?           // Ticket médio em centavos
  priceRange       String?        @default("$$") // "$", "$$", "$$$", "$$$$"
  
  // Documento e Curadoria de Segurança
  documentType     String?        @default("CNPJ") // "CNPJ" ou "CPF"
  documentNumber   String?        
  curationStatus   CurationStatus @default(APPROVED)
  curationNotes    String?        @db.Text

  // Regiões e Atendimento
  serviceRegions   String?        @db.Text // JSON array: ["São Paulo - Capital", "Grande SP", "Litoral", "Campinas"]
  hasPhysicalSpace Boolean        @default(false)
  address          String?        @db.Text
  offersOnlineMeet Boolean        @default(true)
  
  // Contato & Redes Sociais
  phone            String?
  whatsapp         String?
  instagram        String?
  tiktok           String?
  website          String?

  // Assinatura & Reputação
  planTier         VendorPlanTier @default(FREE)
  planExpiresAt    DateTime?      // planos pagos são mensais: depois disso volta ao FREE
  planReminderDays Int?           // último aviso de vencimento enviado (7 ou 1 dia antes)
  isVerified       Boolean        @default(false)
  rating           Float          @default(5.0)
  reviewCount      Int            @default(0)

  leads            VendorLead[]
  reviews          VendorReview[]
  events           VendorEvent[]
  profileViews     VendorProfileView[]
  user             User?          // Login do fornecedor (painel /fornecedor)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("partner_vendors")
}

model VendorReview {
  id          String        @id @default(uuid())
  vendorId    String
  vendor      PartnerVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  coupleNames String        // "Lucas & Giovanna"
  weddingDate DateTime?     // Data do casamento
  rating      Int           @default(5) // 1 a 5 estrelas
  comment     String        @db.Text
  isVerified  Boolean       @default(true)
  // Avaliação feita pelo link de um pedido fechado (verificada)
  leadId      String?       @unique
  lead        VendorLead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  // Resposta pública do fornecedor (painel > Avaliações)
  reply       String?       @db.Text
  repliedAt   DateTime?
  createdAt   DateTime      @default(now())

  @@map("vendor_reviews")
}

model VendorLead {
  id              String         @id @default(uuid())
  vendorId        String
  vendor          PartnerVendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  coupleName      String
  couplePhone     String
  coupleEmail     String?
  weddingDate     DateTime?
  guestCount      Int?
  message         String?        @db.Text
  meetingType     String?        @default("ONLINE") // "ONLINE", "PRESENTIAL"
  location        String?        // cidade do casamento
  budget          String?        // faixa de orçamento informada pelo casal
  status          LeadStatus     @default(NEW)
  // Limite do Start: pedido além dos 3 do mês fica bloqueado até o fornecedor assinar o Pro
  locked          Boolean        @default(false)
  // Proposta registrada pelo fornecedor
  proposalAmount     Int?        // centavos
  proposalDetails    String?     @db.Text
  proposalValidUntil DateTime?
  proposalSentAt     DateTime?
  // Andamento
  respondedAt     DateTime?
  closedAt        DateTime?
  declinedAt      DateTime?
  declineMessage  String?        @db.Text
  // Link público para o casal aceitar a proposta, e o registro do aceite
  proposalToken        String?   @unique
  proposalAcceptedAt   DateTime?
  proposalAcceptedName String?
  proposalAcceptedIp   String?   // hash do IP, só para prova do aceite
  // Link público para o casal avaliar depois do casamento (avaliação verificada)
  reviewToken          String?   @unique
  reviewRequestedAt    DateTime?
  review               VendorReview?
  events          VendorEvent[]
  createdAt       DateTime       @default(now())

  @@index([vendorId, status])
  @@index([createdAt])
  @@map("vendor_leads")
}
// Agenda do fornecedor: reuniões com casais e datas bloqueadas.
// Casamentos fechados vêm dos pedidos (status CLOSED + weddingDate), não daqui.
model VendorEvent {
  id        String        @id @default(uuid())
  vendorId  String
  vendor    PartnerVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  kind      String        // "MEETING" | "BLOCKED"
  date      DateTime      @db.Date
  time      String?       // "19:00" (reuniões)
  title     String
  notes     String?       @db.Text
  leadId    String?
  lead      VendorLead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())

  @@index([vendorId, date])
  @@map("vendor_events")
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  CLOSED
  DECLINED
}

enum CurationStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// ==========================================
// MULTI-CASAMENTO
// ==========================================

// Um casamento: tudo do painel do casal pertence a um casamento.
model Wedding {
  id            String    @id @default(uuid())
  slug          String    @unique // endereço do site: /casamento/<slug>
  coupleNames   String
  weddingDate   DateTime?
  city          String?
  guestEstimate String?   // faixa informada no onboarding
  themeColor    String    @default("#5E2B4E")
  onboardedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  members       User[]
  invites       WeddingInvite[]
  subscriptions Subscription[]
  settings      SystemSettings?
  site          SiteCustomization?
  wallet        WalletBalance?
  guests        Guest[]
  timeline      TimelineEvent[]
  tables        Table[]
  gifts         Gift[]
  transactions  Transaction[]
  vendors       Vendor[]
  expenses      Expense[]
  tasks         Task[]
  honeymoon     HoneymoonItem[]
  templates     MessageTemplate[]
  creditCards   CreditCard[]
  story         WeddingStoryItem[]
  tips          WeddingTip[]
  guestbook     GuestBookEntry[]

  @@map("weddings")
}

// Convite para o par entrar no mesmo casamento.
model WeddingInvite {
  id          String    @id @default(uuid())
  weddingId   String
  wedding     Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  email       String?
  createdById String?
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  createdAt   DateTime  @default(now())

  @@index([weddingId])
  @@map("wedding_invites")
}

// "Esqueci a senha": guarda só o hash do token.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Visitas ao perfil público do fornecedor, por dia (painel de resultados do Master).
model VendorProfileView {
  id       String        @id @default(uuid())
  vendorId String
  vendor   PartnerVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  day      DateTime      @db.Date
  count    Int           @default(0)

  @@unique([vendorId, day])
  @@map("vendor_profile_views")
}

// Cupons de desconto para planos.
model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique // sempre em maiúsculas
  percentOff     Int?      // 1 a 100
  amountOff      Int?      // centavos
  planIds        Json?     // planos aceitos; vazio = todos
  maxRedemptions Int?
  redemptions    Int       @default(0)
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@map("coupons")
}

// Registro das ações da administração (confirmar Pix, curadoria, permissões...).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorName  String?
  action     String   // ex.: "subscription.confirm", "vendor.approve"
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
