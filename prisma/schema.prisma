generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum PaymentStatus {
  PENDING
  APPROVED
  FAILED
  REFUNDED
  REJECTED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
}

enum ExpenseStatus {
  PENDING
  PAID
  OVERDUE
}

enum ExpenseType {
  CONTRACT
  PURCHASE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// ==========================================
// MODELS
// ==========================================

model Guest {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id                 String        @id @default(uuid())
  name               String
  phone              String?       
  email              String?
  category           String?       // Padrinho/Madrinha, Participantes de cerimônia, Pais, Família, Amigo/Colega
  rsvpStatus         RsvpStatus    @default(PENDING)
  allowedCompanions  Int           @default(0)
  confirmedCompanions Int          @default(0)
  companionsNames    String?       @db.Text
  hasReceivedMessage Boolean       @default(false) 
  // Última vez que o casal enviou o convite a este convidado pelo WhatsApp do próprio aparelho (envio manual)
  inviteSharedAt     DateTime?
  
  // Vínculo entre convidados (Titular / Familiar vinculado)
  parentGuestId      String?
  parentGuest        Guest?        @relation("GuestLink", fields: [parentGuestId], references: [id], onDelete: SetNull)
  linkedGuests       Guest[]       @relation("GuestLink")

  // Credenciamento e Restrições
  isPresent          Boolean       @default(false)
  checkInTime        DateTime?
  dietaryRestrictions String?      @db.Text

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tableId            String?
  table              Table?        @relation(fields: [tableId], references: [id])

  transactions       Transaction[] 

  @@index([weddingId])
  @@map("guests")
}

model TimelineEvent {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id          String   @id @default(uuid())
  title       String
  time        String   // Ex: "18:00"
  description String?  @db.Text
  icon        String   @default("Clock") // Nome do ícone no Lucide
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([weddingId])
  @@map("timeline_events")
}

model Table {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id          String   @id @default(uuid())
  name        String
  capacity    Int      @default(10)
  createdAt   DateTime @default(now())

  guests      Guest[]

  @@index([weddingId])
  @@map("tables")
}

model Gift {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id          String        @id @default(uuid())
  title       String
  description String?
  amount      Int           
  imageUrl    String?
  isPurchased Boolean       @default(false)
  createdAt   DateTime      @default(now())

  transactions Transaction[]

  @@index([weddingId])
  @@map("gifts")
}

model Transaction {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id                String        @id @default(uuid())
  gatewayId         String?       
  guestName         String?
  amount            Int           
  netAmount         Int?          
  fee               Int?          @default(0)
  paymentMethod     PaymentMethod 
  status            PaymentStatus @default(PENDING)
  externalReference String?       
  thankYouSent      Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt

  giftId            String
  gift              Gift          @relation(fields: [giftId], references: [id])
  guestId           String?       
  guest             Guest?        @relation(fields: [guestId], references: [id])

  @@index([weddingId])
  @@map("transactions")
}

model Vendor {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id          String    @id @default(uuid())
  name        String
  category    String    
  contact     String?
  contractUrl String?   
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())

  expenses    Expense[]

  @@index([weddingId])
  @@map("vendors")
}

model Expense {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id            String        @id @default(uuid())
  description   String
  amount        Int           
  dueDate       DateTime
  status        ExpenseStatus @default(PENDING)
  type          ExpenseType   @default(CONTRACT)
  purchaseUrl   String?       
  paymentMethod String?       
  imageUrl      String?       @db.Text
  storeName     String?       
  createdAt     DateTime      @default(now())

  vendorId      String?       
  vendor        Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([weddingId])
  @@map("expenses")
}

model Task {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id          String     @id @default(uuid())
  title       String
  description String?    @db.Text
  dueDate     DateTime?
  assignee    String?    
  status      TaskStatus @default(TODO)
  position    Int        
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([weddingId])
  @@map("tasks")
}

model HoneymoonItem {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id          String   @id @default(uuid())
  title       String
  category    String   
  amount      Int      
  isPaid      Boolean  @default(false)
  plannedDate DateTime?
  createdAt   DateTime @default(now())

  @@index([weddingId])
  @@map("honeymoon_items")
}

model MessageTemplate {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id        String   @id @default(uuid())
  name      String
  type      String?  // "INITIAL_INVITE", "RSVP_REMINDER", "CUSTOM"
  content   String   @db.Text
  mediaUrl  String?
  mediaType String?  // Ex: image, document, audio
  buttons   String?  @db.Text // JSON string: [{ id: "confirm", text: "✅ Confirmar Presença" }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weddingId])
  @@map("message_templates")
}

model SystemSettings {
  id                 String    @id @default(uuid())
  weddingId          String    @unique
  wedding            Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  rsvpDeadline       DateTime?
  weddingDate        DateTime?
  weddingLocation    String?   @db.Text
  weddingLocationUrl String?   @db.Text
  themeColor         String    @default("#18181b")
  heroImageUrl       String?
  welcomeText        String?   @db.Text
  updatedAt          DateTime  @updatedAt

  @@map("system_settings")
}

model Role {
  id           String   @id @default(uuid())
  name         String   @unique
  allowedPaths Json     // JSON string array de paths permitidos
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]

  @@map("roles")
}

model User {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  password  String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Conta de fornecedor: vincula o login ao perfil do marketplace (painel /fornecedor)
  partnerVendorId String?        @unique
  partnerVendor   PartnerVendor? @relation(fields: [partnerVendorId], references: [id], onDelete: SetNull)

  // Casamento do qual a conta faz parte (o casal e o par convidado)
  weddingId       String?
  wedding         Wedding?       @relation(fields: [weddingId], references: [id], onDelete: SetNull)

  subscriptions   Subscription[]
  passwordResets  PasswordResetToken[]
  notifications   Notification[]
  pushSubscriptions PushSubscription[]
  notificationPreference NotificationPreference?
  domainOrders    DomainOrder[]

  // Última entrada na conta (administração: "Última atividade" e filtros de casais sem atividade)
  lastLoginAt     DateTime?

  // Passo a passo do painel (por pessoa, não por casamento): o par convidado tem o próprio.
  // panelTourVersion = última versão do passo a passo que a pessoa já resolveu (concluiu, pulou ou nasceu antes dele);
  // 0 = ainda não viu. Contas anteriores à migration 20261012100000_panel_tour entram com 1 (não levam o tour de surpresa).
  panelTourVersion          Int       @default(0)
  panelTourCompletedAt      DateTime?
  panelTourSkippedAt        DateTime?
  // "Primeiros passos" do Resumo dispensado por esta pessoa
  panelChecklistDismissedAt DateTime?

  announcementDeliveries AnnouncementRecipient[]
  supportTickets         SupportTicket[]
  dataRequests           DataRequest[]

  @@map("users")
}

// Central de avisos: um registro por pessoa (avisos do casal viram um por usuário do casamento).
// `type` é uma chave do catálogo (lib/notifications/catalog); `dedupeKey` evita avisos repetidos
// (ex.: "gift_paid:<transação>"), mesmo que o webhook ou a rotina rodem duas vezes.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String    @db.Text
  href      String?
  weddingId String?
  vendorId  String?
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// Escolhas de avisos da pessoa (canais por grupo e horário de silêncio). Só guarda o que ela salvou:
// sem registro valem os padrões de lib/notifications/preferences. `settings` é lido com resolvePrefs,
// que ignora qualquer valor fora do formato.
model NotificationPreference {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  settings  Json
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

// Aparelho que ativou os avisos (Web Push). O endereço (endpoint) é único: o mesmo navegador
// nunca aparece duas vezes, e quem entra depois no mesmo aparelho passa a ser o dono dele.
model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique @db.Text
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// Cobrança de um plano pago (Pix). O plano só é aplicado quando o pagamento é aprovado,
// pelo webhook do Mercado Pago ou pela conferência na tela do Pix (o que chegar primeiro).
model Subscription {
  id          String        @id @default(uuid())
  // Conta que pagou. Fica nulo se a conta for excluída: o pagamento é guardado para fins fiscais.
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  planId      String        // chave do catálogo (lib/plans): classic, vip, pro, master ou custom
  planType    String        // "COUPLE" | "VENDOR"
  planName    String
  modules     Json?         // módulos do plano adaptado
  weddingId   String?       // planos de casal valem para o casamento (os dois do casal)
  wedding     Wedding?      @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  couponCode  String?
  discount    Int?          // centavos abatidos por cupom
  credit      Int?          // centavos abatidos pelo período não usado (troca de plano)
  amount      Int           // centavos, sempre do catálogo
  status      PaymentStatus @default(PENDING)
  gatewayId   String?       @unique // id do pagamento no Mercado Pago (ou txid do Pix estático)
  expiresAt   DateTime      // validade do código Pix
  paidAt      DateTime?
  periodEnd   DateTime?     // fim do período pago (planos mensais de fornecedor)
  // Administração: nota fiscal deste pagamento (controle do contador; só pagamentos aprovados)
  invoiceIssuedAt DateTime?
  invoiceNumber   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  domainOrders  DomainOrder[]
  refundRequests RefundRequest[]

  @@index([userId, status])
  @@index([weddingId, status])
  @@map("subscriptions")
}

model WalletBalance {
  id        String   @id @default(uuid())
  weddingId String   @unique
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  balance   Int      @default(0) // Valor em centavos
  updatedAt DateTime @updatedAt

  @@map("wallet_balance")
}

model CreditCard {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id         String   @id @default(uuid())
  bank       String   
  brand      String   
  nickname   String?  
  lastDigits String?  
  limit      Int      @default(0) // Limite atual em centavos
  color      String?  @default("#18181b") 
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([weddingId])
  @@map("credit_cards")
}

// ==========================================
// CONSTRUTOR DE SITE NO-CODE & STORYTELLING
// ==========================================

model SiteCustomization {
  id                 String   @id @default(uuid())
  weddingId          String   @unique
  wedding            Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  slug               String   @default("lucas-e-giovanna")
  customDomain       String?  
  title              String   @default("Lucas & Giovanna")
  subtitle           String   @default("Vamos nos casar!")
  weddingDate        DateTime?
  ceremonyTime       String?  @default("16:30")
  receptionTime      String?  @default("18:30")
  locationName       String?  @default("Espaço Monte Castelo")
  locationAddress    String?  @default("Rua das Flores, 1200 - São Paulo, SP")
  locationMapUrl     String?  @db.Text
  wazeUrl            String?  @db.Text
  uberUrl            String?  @db.Text
  themeColor         String   @default("#8C6D45")
  fontFamily         String   @default("serif") // "serif", "sans", "playfair", "cormorant"
  heroImageUrl       String?  @db.Text
  couplePhotoUrl     String?  @db.Text
  dressCodeTitle     String?  @default("Passeio Completo")
  dressCodeDesc      String?  @db.Text
  dressCodePalette   String?  // JSON array de cores hexadecimais
  spotifyPlaylistUrl String?  @db.Text
  welcomeMessage     String?  @db.Text

  // Liga / Desliga de Blocos Modulares
  showStory          Boolean  @default(true)
  showLocation       Boolean  @default(true)
  showDressCode      Boolean  @default(true)
  showTips           Boolean  @default(true)
  showGifts          Boolean  @default(true)
  showRsvp           Boolean  @default(true)
  showGuestbook      Boolean  @default(true)
  showMusic          Boolean  @default(true)

  updatedAt          DateTime @updatedAt

  @@map("site_customization")
}

model WeddingStoryItem {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id          String   @id @default(uuid())
  title       String   // Ex: "O Primeiro Encontro", "O Pedido de Casamento"
  dateLabel   String?  // Ex: "Outubro de 2021"
  description String   @db.Text
  imageUrl    String?  @db.Text
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([weddingId])
  @@map("wedding_story_items")
}

model WeddingTip {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id          String   @id @default(uuid())
  category    String   // "HOTEL", "SALON", "TRANSFER", "DRESS"
  title       String   // Ex: "Hotel Blue Tree", "Salão Studio Beauty"
  description String?  @db.Text
  address     String?  
  phone       String?  
  linkUrl     String?  @db.Text
  discountCode String? // Ex: "CASAMENTOLUCAS10"
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([weddingId])
  @@map("wedding_tips")
}

model GuestBookEntry {
  // Casamento dono deste registro (multi-casamento)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  id          String   @id @default(uuid())
  authorName  String
  message     String   @db.Text
  imageUrl    String?  @db.Text
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([weddingId])
  @@map("guest_book_entries")
}

// ==========================================
// MARKETPLACE DE FORNECEDORES POR REGIÃO
// ==========================================

enum VendorPlanTier {
  FREE
  PRO
  MASTER
}

model PartnerVendor {
  id               String         @id @default(uuid())
  companyName      String
  category         String         // "Espaço", "Buffet", "Fotografia", "Decoração", "DJ & Som", "Vestidos", "Doces & Bolo"
  description      String?        @db.Text
  logoUrl          String?        @db.Text
  coverUrl         String?        @db.Text
  galleryImages    String?        @db.Text // JSON string array de URLs
  startingPrice    Int?           // Valor inicial em centavos (ex: 250000 = R$ 2.500)
  averageTicket    Int?           // Ticket médio em centavos
  priceRange       String?        @default("$$") // "$", "$$", "$$$", "$$$$"
  
  // Documento e Curadoria de Segurança
  documentType     String?        @default("CNPJ") // "CNPJ" ou "CPF"
  documentNumber   String?        
  curationStatus   CurationStatus @default(APPROVED)
  curationNotes    String?        @db.Text

  // Regiões e Atendimento
  serviceRegions   String?        @db.Text // JSON array: ["São Paulo - Capital", "Grande SP", "Litoral", "Campinas"]
  hasPhysicalSpace Boolean        @default(false)
  address          String?        @db.Text
  offersOnlineMeet Boolean        @default(true)
  
  // Contato & Redes Sociais
  phone            String?
  whatsapp         String?
  instagram        String?
  tiktok           String?
  website          String?

  // Assinatura & Reputação
  planTier         VendorPlanTier @default(FREE)
  planExpiresAt    DateTime?      // planos pagos são mensais: depois disso volta ao FREE
  planReminderDays Int?           // último aviso de vencimento enviado (7 ou 1 dia antes)
  isVerified       Boolean        @default(false)
  rating           Float          @default(5.0)
  reviewCount      Int            @default(0)

  // Administração: suspenso some da vitrine (as consultas públicas filtram suspendedAt = null);
  // destaque coloca o perfil no topo da categoria e da região.
  suspendedAt      DateTime?
  suspendedReason  String?        @db.Text
  isFeatured       Boolean        @default(false)

  leads            VendorLead[]
  reviews          VendorReview[]
  events           VendorEvent[]
  profileViews     VendorProfileView[]
  adminNotes       AdminNote[]
  supportTickets   SupportTicket[]
  user             User?          // Login do fornecedor (painel /fornecedor)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("partner_vendors")
}

model VendorReview {
  id          String        @id @default(uuid())
  vendorId    String
  vendor      PartnerVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  coupleNames String        // "Lucas & Giovanna"
  weddingDate DateTime?     // Data do casamento
  rating      Int           @default(5) // 1 a 5 estrelas
  comment     String        @db.Text
  isVerified  Boolean       @default(true)
  // Avaliação feita pelo link de um pedido fechado (verificada)
  leadId      String?       @unique
  lead        VendorLead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  // Resposta pública do fornecedor (painel > Avaliações)
  reply       String?       @db.Text
  repliedAt   DateTime?
  // Moderação (administração): denúncia do fornecedor e avaliação ocultada (some do perfil público)
  reportedAt   DateTime?
  reportReason String?       @db.Text
  hiddenAt     DateTime?
  hiddenReason String?       @db.Text
  moderatedAt  DateTime?     // a administração já analisou a denúncia (manter ou ocultar)
  createdAt   DateTime      @default(now())

  @@index([reportedAt])
  @@map("vendor_reviews")
}

model VendorLead {
  id              String         @id @default(uuid())
  vendorId        String
  vendor          PartnerVendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  coupleName      String
  couplePhone     String
  coupleEmail     String?
  weddingDate     DateTime?
  guestCount      Int?
  message         String?        @db.Text
  meetingType     String?        @default("ONLINE") // "ONLINE", "PRESENTIAL"
  location        String?        // cidade do casamento
  budget          String?        // faixa de orçamento informada pelo casal
  status          LeadStatus     @default(NEW)
  // Limite do Start: pedido além dos 3 do mês fica bloqueado até o fornecedor assinar o Pro
  locked          Boolean        @default(false)
  // Proposta registrada pelo fornecedor
  proposalAmount     Int?        // centavos
  proposalDetails    String?     @db.Text
  proposalValidUntil DateTime?
  proposalSentAt     DateTime?
  // Andamento
  respondedAt     DateTime?
  closedAt        DateTime?
  declinedAt      DateTime?
  declineMessage  String?        @db.Text
  // Link público para o casal aceitar a proposta, e o registro do aceite
  proposalToken        String?   @unique
  proposalAcceptedAt   DateTime?
  proposalAcceptedName String?
  proposalAcceptedIp   String?   // hash do IP, só para prova do aceite
  // Link público para o casal avaliar depois do casamento (avaliação verificada)
  reviewToken          String?   @unique
  reviewRequestedAt    DateTime?
  review               VendorReview?
  events          VendorEvent[]
  createdAt       DateTime       @default(now())

  @@index([vendorId, status])
  @@index([createdAt])
  @@map("vendor_leads")
}
// Agenda do fornecedor: reuniões com casais e datas bloqueadas.
// Casamentos fechados vêm dos pedidos (status CLOSED + weddingDate), não daqui.
model VendorEvent {
  id        String        @id @default(uuid())
  vendorId  String
  vendor    PartnerVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  kind      String        // "MEETING" | "BLOCKED"
  date      DateTime      @db.Date
  time      String?       // "19:00" (reuniões)
  title     String
  notes     String?       @db.Text
  leadId    String?
  lead      VendorLead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())

  @@index([vendorId, date])
  @@map("vendor_events")
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  CLOSED
  DECLINED
}

enum CurationStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// ==========================================
// MULTI-CASAMENTO
// ==========================================

// Um casamento: tudo do painel do casal pertence a um casamento.
// Pedido de domínio próprio (.com.br) registrado no nome do cliente. Ativos: tudo menos REJECTED e CANCELED.
enum DomainOrderStatus {
  REQUESTED   // pedido recebido, aguardando o registro
  REGISTERING // o dono do Aceito começou o registro
  REGISTERED  // registrado no nome do titular
  CONNECTED   // apontado para o site e no ar
  REJECTED    // recusado (com motivo)
  CANCELED    // cancelado pelo casal antes de começar
}

model Wedding {
  id            String    @id @default(uuid())
  slug          String    @unique // endereço do site: /casamento/<slug>
  coupleNames   String
  weddingDate   DateTime?
  city          String?
  guestEstimate String?   // faixa informada no onboarding
  themeColor    String    @default("#5E2B4E")
  onboardedAt   DateTime?
  // Domínio próprio já conectado e no ar (sem "www."): só depois de um pedido CONNECTED
  customDomain  String?   @unique
  // Administração: suspenso tira o site do ar e deixa o painel só para leitura
  suspendedAt     DateTime?
  suspendedReason String?   @db.Text
  // "Marcar para acompanhar" na lista de casais
  flaggedAt       DateTime?
  // Última visita ao painel do casal (gravada no máximo a cada 30 min)
  lastActiveAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  members       User[]
  domainOrders  DomainOrder[]
  invites       WeddingInvite[]
  subscriptions Subscription[]
  settings      SystemSettings?
  site          SiteCustomization?
  wallet        WalletBalance?
  guests        Guest[]
  timeline      TimelineEvent[]
  tables        Table[]
  gifts         Gift[]
  transactions  Transaction[]
  vendors       Vendor[]
  expenses      Expense[]
  tasks         Task[]
  honeymoon     HoneymoonItem[]
  templates     MessageTemplate[]
  creditCards   CreditCard[]
  story         WeddingStoryItem[]
  tips          WeddingTip[]
  guestbook     GuestBookEntry[]
  adminNotes    AdminNote[]
  impersonations ImpersonationSession[]
  madrinhaOverride MadrinhaWeddingOverride?
  supportTickets SupportTicket[]
  dataRequests  DataRequest[]

  @@index([createdAt])
  @@index([weddingDate])
  @@map("weddings")
}

// Convite para o par entrar no mesmo casamento.
// Índices únicos parciais (só entre pedidos ativos) existem na migration 20261010160000_domain_orders:
// o Prisma não os descreve aqui. Um domínio e um casamento têm no máximo um pedido ativo.
model DomainOrder {
  id                String            @id @default(uuid())
  weddingId         String
  wedding           Wedding           @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  requestedByUserId String?
  requestedBy       User?             @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  subscriptionId    String?
  subscription      Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  domain            String            // ex.: ana-e-rafael.com.br
  status            DomainOrderStatus @default(REQUESTED)
  holderName        String            // nome completo ou razão social do titular
  // CPF/CNPJ completo só enquanto o pedido não é concluído; ao virar REGISTERED é trocado pela versão escondida
  holderDocument    String
  holderEmail       String
  holderPhone       String
  adminNote         String?
  rejectionReason   String?
  requestedAt       DateTime          @default(now())
  registeredAt      DateTime?
  expiresAt         DateTime?         // vencimento anual no Registro.br
  connectedAt       DateTime?
  vercelState       String?           // última situação lida da Vercel: pending, verified, misconfigured...
  renewalReminderDays Int?            // último aviso de renovação enviado ao casal (60 ou 30 dias antes de vencer)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, requestedAt])
  @@index([weddingId])
  @@map("domain_orders")
}

model WeddingInvite {
  id          String    @id @default(uuid())
  weddingId   String
  wedding     Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  email       String?
  createdById String?
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  createdAt   DateTime  @default(now())

  @@index([weddingId])
  @@map("wedding_invites")
}

// "Esqueci a senha": guarda só o hash do token.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Visitas ao perfil público do fornecedor, por dia (painel de resultados do Master).
model VendorProfileView {
  id       String        @id @default(uuid())
  vendorId String
  vendor   PartnerVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  day      DateTime      @db.Date
  count    Int           @default(0)

  @@unique([vendorId, day])
  @@map("vendor_profile_views")
}

// Cupons de desconto para planos.
model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique // sempre em maiúsculas
  percentOff     Int?      // 1 a 100
  amountOff      Int?      // centavos
  planIds        Json?     // planos aceitos; vazio = todos
  maxRedemptions Int?
  redemptions    Int       @default(0)
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@map("coupons")
}

// Registro das ações da administração (confirmar Pix, curadoria, permissões...).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorName  String?
  action     String   // ex.: "subscription.confirm", "vendor.approve"
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}


// ==========================================
// ADMINISTRAÇÃO DA PLATAFORMA (/admin)
// Contrato com as telas em design-admin-impl/SCHEMA.md. Só a administração ("*") lê e escreve aqui.
// ==========================================

// Nota interna sobre um casal ou fornecedor ("Só a equipe vê"). Nunca aparece para o casal.
model AdminNote {
  id         String         @id @default(uuid())
  weddingId  String?
  wedding    Wedding?       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  vendorId   String?
  vendor     PartnerVendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  authorId   String?        // "super-admin" para a conta de emergência
  authorName String
  body       String         @db.Text
  createdAt  DateTime       @default(now())

  @@index([weddingId, createdAt])
  @@index([vendorId, createdAt])
  @@map("admin_notes")
}

// "Entrar como este casal": cada entrada fica registrada (quem, por quê, até quando, se pôde editar).
// O navegador guarda só o id desta sessão em um cookie; a validade e o dono são sempre conferidos aqui.
model ImpersonationSession {
  id           String    @id @default(uuid())
  adminUserId  String    // "super-admin" para a conta de emergência
  adminName    String
  weddingId    String?
  wedding      Wedding?  @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  weddingNames String    // nomes do casal na hora da entrada (o registro sobrevive à exclusão do casamento)
  reason       String    // motivo escolhido na tela
  ticketNumber Int?      // chamado relacionado (SupportTicket.number), opcional
  canEdit      Boolean   @default(false) // false = painel só para leitura
  startedAt    DateTime  @default(now())
  expiresAt    DateTime
  endedAt      DateTime?
  endedReason  String?   // "manual" | "expired"

  @@index([adminUserId, endedAt])
  @@index([weddingId, startedAt])
  @@map("impersonation_sessions")
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELED
}

enum AnnouncementChannel {
  PANEL
  PUSH
  EMAIL
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// Comunicado da plataforma para casais e fornecedores. `audience` guarda o filtro escolhido
// (público, planos, janela da data do casamento); os destinatários reais ficam em AnnouncementRecipient.
model Announcement {
  id             String                @id @default(uuid())
  title          String
  emailSubject   String?
  body           String                @db.Text
  linkUrl        String?
  audience       Json
  channels       AnnouncementChannel[]
  status         AnnouncementStatus    @default(DRAFT)
  scheduledFor   DateTime?
  sentAt         DateTime?
  recipientCount Int                   @default(0)
  deliveredCount Int                   @default(0)
  failedCount    Int                   @default(0)
  createdById    String?
  createdByName  String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  recipients     AnnouncementRecipient[]

  @@index([status, scheduledFor])
  @@index([createdAt])
  @@map("announcements")
}

// Uma linha por pessoa e canal. "Lidos" do aviso no painel vem de Notification.readAt (dedupeKey "announcement:<id>").
model AnnouncementRecipient {
  id             String              @id @default(uuid())
  announcementId String
  announcement   Announcement        @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        AnnouncementChannel
  status         DeliveryStatus      @default(PENDING)
  error          String?
  sentAt         DateTime?

  @@unique([announcementId, userId, channel])
  @@index([announcementId, status])
  @@map("announcement_recipients")
}

enum SupportTicketStatus {
  NEW
  IN_PROGRESS
  ANSWERED
  CLOSED
}

// Pedido de ajuda registrado pela equipe (recebido por WhatsApp, e-mail ou conversa). Não há formulário
// público ainda: o chamado nasce na tela Suporte e LGPD.
model SupportTicket {
  id             String              @id @default(uuid())
  number         Int                 @unique @default(autoincrement()) // "#2041"
  subject        String
  body           String?             @db.Text
  requesterName  String
  requesterEmail String?
  requesterPhone String?
  weddingId      String?
  wedding        Wedding?            @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  vendorId       String?
  vendor         PartnerVendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  status         SupportTicketStatus @default(NEW)
  assigneeId     String?
  assigneeName   String?
  internalNote   String?             @db.Text
  answeredAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, createdAt])
  @@map("support_tickets")
}

enum DataRequestType {
  EXPORT
  DELETE
  CORRECTION
  OTHER
}

enum DataRequestStatus {
  NEW
  IN_REVIEW
  DONE
  REFUSED
}

// Pedido de titular sobre dados pessoais (LGPD). `dueAt` = recebimento + prazo legal (15 dias, a confirmar com o jurídico).
// Exportação e exclusão feitas pela própria pessoa em "Minha conta" continuam sem registro aqui.
model DataRequest {
  id             String            @id @default(uuid())
  type           DataRequestType
  requesterName  String
  requesterEmail String
  userId         String?
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  weddingId      String?
  wedding        Wedding?          @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  status         DataRequestStatus @default(NEW)
  receivedAt     DateTime          @default(now())
  dueAt          DateTime
  completedAt    DateTime?
  note           String?           @db.Text
  handledById    String?
  handledByName  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, dueAt])
  @@map("data_requests")
}

enum IncidentStatus {
  OPEN
  CLOSED
}

// Incidente de segurança: o que foi afetado, quando e quem foi avisado.
model SecurityIncident {
  id            String         @id @default(uuid())
  title         String
  description   String         @db.Text
  affected      String?        @db.Text
  discoveredAt  DateTime
  notifiedAt    DateTime?
  notifiedWho   String?        @db.Text
  status        IncidentStatus @default(OPEN)
  closedAt      DateTime?
  createdById   String?
  createdByName String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, discoveredAt])
  @@map("security_incidents")
}

// Configurações da plataforma e da Madrinha: uma linha por chave, valor em JSON validado pelo código
// (lib/platform/settings.ts). Sem linha, vale o padrão do código.
model PlatformSetting {
  key           String   @id
  value         Json
  updatedAt     DateTime @updatedAt
  updatedById   String?
  updatedByName String?

  @@map("platform_settings")
}

// Preço editável do catálogo: sobrepõe o valor de lib/plans (chave "plan:classic") ou de
// lib/pricing-modules (chave "module:presentes"). Vale só para compras novas: Subscription.amount guarda o que foi cobrado.
// O histórico das mudanças fica no AuditLog (ação "catalog.price_update", com o motivo).
model CatalogPrice {
  key           String   @id
  priceCents    Int
  name          String?
  reason        String?
  updatedAt     DateTime @updatedAt
  updatedById   String?
  updatedByName String?

  @@map("catalog_prices")
}

// Pedido de reembolso de um pagamento de plano. O estorno em si chega pelo webhook do Mercado Pago
// (Subscription.status = REFUNDED); aqui fica a decisão e o motivo.
enum RefundStatus {
  REQUESTED
  REFUNDED
  DENIED
}

model RefundRequest {
  id              String        @id @default(uuid())
  subscriptionId  String
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount          Int           // centavos a devolver
  reason          String        @db.Text
  requestedByName String?
  status          RefundStatus  @default(REQUESTED)
  dueAt           DateTime?     // responder até
  decidedAt       DateTime?
  decidedByName   String?
  decisionNote    String?       @db.Text
  gatewayRefundId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, dueAt])
  @@index([subscriptionId])
  @@map("refund_requests")
}

enum CronRunStatus {
  OK
  FAILED
}

// Registro de cada execução das rotinas diárias (Saúde do sistema). Rotina sem registro = "ainda não rodou".
model CronRun {
  id         String        @id @default(uuid())
  job        String        // "expirar-planos" | "avisos" | ...
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  status     CronRunStatus
  summary    Json?         // contagens do resultado (ex.: { expired: 2, reminders: 5 })
  error      String?       @db.Text

  @@index([job, startedAt])
  @@map("cron_runs")
}

// Resultado de chamadas a serviços externos (Mercado Pago, e-mail, WhatsApp, push), para a Saúde do sistema.
// Guarda só o necessário: nunca corpo de mensagem, e-mail, telefone ou chave. Limpo depois de 30 dias.
model ServiceEvent {
  id        String   @id @default(uuid())
  service   String   // "mercadopago" | "email" | "whatsapp" | "push"
  kind      String   // ex.: "webhook", "send"
  ok        Boolean
  message   String?  // motivo curto da falha
  refId     String?  // id interno relacionado (assinatura, transação)
  createdAt DateTime @default(now())

  @@index([service, createdAt])
  @@index([createdAt])
  @@map("service_events")
}

// ---------- Madrinha (ainda sem IA conectada: só configuração, sem conversas nem custos) ----------

enum MadrinhaContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Instruções da Madrinha, versionadas. No máximo uma publicada; a mais nova em rascunho é a que se edita.
model MadrinhaInstructionVersion {
  id            String                @id @default(uuid())
  version       Int                   @unique
  content       String                @db.Text
  changeNote    String?
  status        MadrinhaContentStatus @default(DRAFT)
  createdById   String?
  createdByName String?
  createdAt     DateTime              @default(now())
  publishedAt   DateTime?

  @@index([status])
  @@map("madrinha_instruction_versions")
}

// Base de conhecimento: textos de ajuda que a Madrinha poderá consultar.
model MadrinhaKnowledgeArticle {
  id          String                @id @default(uuid())
  title       String
  content     String                @db.Text
  status      MadrinhaContentStatus @default(DRAFT)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  publishedAt DateTime?

  @@map("madrinha_knowledge_articles")
}

// Ajuste da Madrinha para um casal: ligar/desligar, mensagens a mais no mês e bloqueio por abuso.
model MadrinhaWeddingOverride {
  id            String    @id @default(uuid())
  weddingId     String    @unique
  wedding       Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  enabled       Boolean?  // null = segue o padrão do plano
  extraMessages Int       @default(0)
  blockedAt     DateTime?
  blockedReason String?   @db.Text
  note          String?   @db.Text
  updatedAt     DateTime  @updatedAt

  @@map("madrinha_wedding_overrides")
}
