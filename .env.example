# ==========================================
# MarryApp: variáveis de ambiente
# Copie para .env.local e preencha. Nunca faça commit de valores reais.
# ==========================================

# --- Banco de dados (Postgres / Supabase) ---
# Conexão via pooler (porta 6543) usada pela aplicação
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Conexão direta (porta 5432) usada pelas migrations
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Autenticação ---
# Obrigatório em produção, mínimo de 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=""
# Opcional: login de emergência "admin". Deixe vazio para desativar.
ADMIN_PASSWORD=""

# --- URL pública ---
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Mercado Pago ---
MERCADOPAGO_ACCESS_TOKEN=""
# Chave pública usada no navegador para tokenizar cartões (MercadoPago.js)
# (ou NEXT_PUBLIC_MP_PUBLIC_KEY)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
# Segredo de assinatura dos webhooks (Painel MP > Webhooks > Assinatura secreta).
# O webhook (/api/webhooks/mercadopago, evento "Pagamentos") confirma presentes e ativa planos pagos.
MERCADOPAGO_WEBHOOK_SECRET=""
MP_FEE_PERCENT="4.99"
MP_FEE_FIXED="0"

# --- Pix estático (fallback quando o Mercado Pago não está disponível) ---
PIX_KEY=""
PIX_MERCHANT_NAME=""
PIX_MERCHANT_CITY=""

# --- Rotinas agendadas (Vercel Cron, ver vercel.json) ---
# A Vercel envia este segredo em "Authorization: Bearer ...". Sem ele, a rotina que
# devolve ao plano gratuito os fornecedores com o mês vencido e os avisos diários
# (despesas do casal, vencimento de plano) não rodam.
CRON_SECRET=""

# --- Supabase Storage (upload de imagens) ---
NEXT_PUBLIC_SUPABASE_URL=""
# (ou SUPABASE_SERVICE_ROLE_KEY, nome criado pela integração Supabase da Vercel)
SUPABASE_SERVICE_KEY=""
SUPABASE_STORAGE_BUCKET="gifts"

# --- WhatsApp (Evolution API) ---
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""

# --- Rate limiting distribuído (recomendado em produção/serverless) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- E-mail transacional (Resend) ---
# Convite do par e "esqueci a senha". Sem a chave, nada é enviado (só um aviso no log)
# e o convite continua funcionando pelo link copiado.
RESEND_API_KEY=""
# Remetente (domínio verificado na Resend). Padrão: "Aceito <nao-responda@meuaceito.com.br>"
EMAIL_FROM=""

# --- Avisos no aparelho (Web Push, sem serviço externo) ---
# Gere o par de chaves uma vez com:  npx web-push generate-vapid-keys
# A pública é enviada ao navegador; a privada nunca sai do servidor. Sem as duas, o push fica
# desligado em silêncio (o sino dentro do app continua funcionando). Trocar as chaves depois
# desativa os aparelhos já cadastrados: as pessoas precisam ativar os avisos de novo.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contato do remetente, exigido pelos serviços de push (mailto: ou https:)
VAPID_SUBJECT="mailto:contato@meuaceito.com.br"

# --- Monitoramento de erros (opcional) ---
# DSN do projeto no Sentry (https://<chave>@<host>/<id-do-projeto>). Se ficar vazio, nenhum erro é enviado.
# Os erros de servidor são enviados por HTTP (src/instrumentation.ts), sem cookies, headers nem corpo da requisição.
SENTRY_DSN=""
